# PartyDeck — copy to .env.local and fill in. Never commit .env.local.
# These are PUBLIC values (they ship in the browser bundle). PKCE needs no client secret:
# never put a Spotify client secret in any VITE_ variable.

# From https://developer.spotify.com/dashboard → your app → Settings
VITE_SPOTIFY_CLIENT_ID=

# Must exactly match a Redirect URI registered in the Spotify app settings.
# Local dev: http://127.0.0.1:5173/callback   (Spotify rejects "localhost")
# Production: https://<your-domain>/callback
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
